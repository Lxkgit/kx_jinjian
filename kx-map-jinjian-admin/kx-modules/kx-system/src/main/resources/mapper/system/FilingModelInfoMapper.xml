<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.FilingModelInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="filingModelInfoResultMap" type="com.kx.system.domain.filing.FilingModelInfo">
        <id column="id" property="id" />
        <result column="model_name" property="modelName" />
        <result column="model_type" property="modelType" />
        <result column="status" property="status" />
        <result column="create_by" property="createBy" />
        <result column="create_org" property="createOrg" />
        <result column="priority" property="priority" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="editable" property="editable" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="columns">
        id, model_name, model_type, status, create_by,create_org,priority, create_time, update_time
    </sql>

    <!-- 查询列表 -->
    <select id="list" parameterType="com.kx.system.domain.filing.FilingModelInfo" resultMap="filingModelInfoResultMap">
        select <include refid="columns"/>,
        case when model_id is null then true else false end as editable
        from filing_model_info f
        left join (select distinct model_id from filing_customer_info) md on f.id = md.model_id
        <where>
            <if test=" modelName!=null and modelName !='' "> and model_name = #{modelName } </if>
            <if test=" modelType!=null and modelType !='' "> and model_type = #{modelType } </if>
            <if test=" status!=null and status !='' "> and status = #{status } </if>
            <if test=" createBy!=null and createBy !='' "> and create_by = #{createBy } </if>
            <if test=" createOrg!=null and createOrg !='' "> and create_org = #{createOrg } </if>
            <if test=" priority!=null and priority !='' "> and priority = #{priority } </if>
            <if test=" createTime!=null "> and create_time = #{createTime } </if>
            <if test=" updateTime!=null "> and update_time = #{updateTime } </if>
            <if test=" userList!=null and userList.size>0 ">and create_org in
                <foreach item="item" collection="userList" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
        order by create_time desc
    </select>

    <!-- 根据id查询 -->
    <select id="getById"  resultMap="filingModelInfoResultMap">
        select <include refid="columns"/>  from filing_model_info where id = #{id}
    </select>
    <select id="countModelByCodeAndType" resultMap="filingModelInfoResultMap">
        select <include refid="columns"/>  from  filing_model_info where model_type = #{modelType } and  status ='1' and  create_org = #{createOrg } and  id !=#{id}
    </select>

    <!-- 根据id删除 -->
    <delete id="deleteById">
        delete from  filing_model_info where  id= #{id}
    </delete>

    <!-- 新增 -->
    <insert id="insertFilingModelInfo" parameterType="com.kx.system.domain.filing.FilingModelInfo" keyProperty="id" useGeneratedKeys="true">
        insert into filing_model_info(
            model_name,model_type,status,create_by,create_org,priority,create_time,update_time
        )values(
             #{modelName}, #{modelType},#{status}, #{createBy},#{createOrg},#{priority}, #{createTime}, #{updateTime}
        )
    </insert>

    <!-- 更新 -->
    <update id="updateFilingModelInfo" parameterType="com.kx.system.domain.filing.FilingModelInfo">
        update filing_model_info
    <trim prefix="SET" suffixOverrides=",">
        <if test=" modelName!=null and modelName !='' ">  model_name = #{modelName } ,</if>
        <if test=" modelType!=null and modelType !='' ">  model_type = #{modelType } ,</if>
        <if test=" status!=null and status !='' ">  status = #{status } ,</if>
        <if test=" createBy!=null and createBy !='' ">  create_by = #{createBy } ,</if>
        <if test=" createOrg!=null and createOrg !='' ">  create_org = #{createOrg } ,</if>
        <if test=" priority!=null and priority !='' ">  priority = #{priority } ,</if>
        <if test=" createTime!=null ">  create_time = #{createTime } ,</if>
        <if test=" updateTime!=null ">  update_time = #{updateTime } </if>
    </trim>
     where id = #{id}
    </update>
</mapper>
