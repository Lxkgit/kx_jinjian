<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.TaskTypeMapper">

    <!-- 基础resultMap -->
    <resultMap id="BaseResultMap" type="com.kx.system.domain.task.TaskType">
        <id column="id" property="id" />
        <result column="type_name" property="typeName" />
        <result column="create_time" property="createTime" />
        <result column="create_name" property="createName" />
        <result column="create_by" property="createBy" />
        <result column="update_time" property="updateTime" />
        <result column="update_name" property="updateName" />
        <result column="update_by" property="updateBy" />
    </resultMap>

    <!-- 新增记录 -->
    <insert id="insertTaskType" parameterType="com.kx.system.domain.task.TaskType" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO task_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">type_name,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createName != null and createName != ''">create_name,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateName != null and updateName != ''">update_name,</if>
            <if test="updateBy != null">update_by,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="typeName != null and typeName != ''">#{typeName},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createName != null and createName != ''">#{createName},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateName != null and updateName != ''">#{updateName},</if>
            <if test="updateBy != null">#{updateBy},</if>
        </trim>
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteTaskTypeById" parameterType="java.lang.Long">
        DELETE FROM task_type WHERE id = #{id}
    </delete>

    <!-- 更新记录 -->
    <update id="updateTaskType" parameterType="com.kx.system.domain.task.TaskType">
        UPDATE task_type
        <set>
            <if test="typeName != null">type_name = #{typeName},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateName != null">update_name = #{updateName},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询 -->
    <select id="selectTaskTypeById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT * FROM task_type WHERE id = #{id}
    </select>

    <!-- 条件查询（网格编码字段） -->
    <select id="selectByCondition" parameterType="map" resultMap="BaseResultMap">
        SELECT * FROM task_type
        <where>
            <if test="typeName != null and typeName != ''">
                AND type_name LIKE CONCAT('%', #{typeName}, '%')
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
