    <select id="selectDeptIdByCustomerIds" resultType="com.kx.system.domain.DeptList">
        select DISTINCT duty_dept_id as dept_id, dept_name from customer_info ci
        left join sys_dept sd on sd.dept_id = ci.duty_dept_id
        <where> id in
            <foreach collection="customerIdList" item="customerId" open="(" close=")" separator=",">
                #{customerId}
            </foreach>
        </where>
    </select>
    <select id="queryBusinessManage" resultType="com.kx.system.domain.vo.TaskManagerVO">
        select concat(nick_name,user_name) as business_manage_user,user_name as manager_num from sys_user
        <where>
            <if test="deptIdReq.managerName != null and deptIdReq.managerName != '' ">
                nick_name like concat('%', #{deptIdReq.managerName}, '%') or manager_num like concat('%', #{deptIdReq.managerName}, '%')
            </if>
            <if test="deptIdReq.deptIdList != null and !deptIdReq.deptIdList.isEmpty()">
                duty_dept_id in
                <foreach collection="deptIdReq.deptIdList" item="deptId" open="(" close=")" separator=",">
                    #{deptId}
                </foreach>
            </if>
        </where>
        limit 10
    </select>
    <select id="selectBelongGridName" resultType="java.lang.String">
