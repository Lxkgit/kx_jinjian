        select distinct ci.[name], ci.nm, ci.credit_code, ci.address, ci.telephone, ci.legal_person, ci.capital,
        ci.[scope], ci.industry, ci.etl_dt, cai.outlet_code, cai.outlet, cai.manager_id, cai.township, cai.area,
