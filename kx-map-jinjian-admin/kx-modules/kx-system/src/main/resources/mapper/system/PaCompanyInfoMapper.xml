    <select id="selectNewCompanyInfo" parameterType="String" resultMap="CompanyAndBelongMap">
        select ci.[name],
               ci.nm,
               cai.outlet_code,
               cai.outlet,
               cai.area_code,
               cai.lon,
               cai.lat,
               cai.del_flag,
               cai.manager_id,
               cai.township,
               cai.area,
               cai.type
        from pa_company_info as ci
                 left join pa_company_belong_info as cai on ci.nm = cai.nm
        where ci.etl_dt >= #{nowDate}
    </select>
    <select id="selectAllCompanyInfo" resultMap="CompanyAndBelongMap">
        select ci.[name],
               ci.nm,
               cai.outlet_code,
               cai.outlet,
               cai.area_code,
               cai.lon,
               cai.lat,
               cai.del_flag,
               cai.manager_id,
               cai.township,
               cai.area,
               cai.type
        from pa_company_info as ci
                 left join pa_company_belong_info as cai on ci.nm = cai.nm
        <if test="etlDt != null">
            where ci.etl_dt = #{etlDt}
        </if>
    </select>
    <select id="selectByEtlDtBetween" resultMap="BaseResultMap">
        <include refid="selectPaCompanyInfoVo"/>
        where
        etl_dt between #{beginEtlDt,jdbcType=TIMESTAMP} and #{endEtlDt,jdbcType=TIMESTAMP}
    </select>

    <select id="getByCreditCode" resultMap="BaseResultMap">
