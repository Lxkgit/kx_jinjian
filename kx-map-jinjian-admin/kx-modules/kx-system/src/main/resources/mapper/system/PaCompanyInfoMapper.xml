    <sql id="selectPaCompanyInfoVo">
        <!--@mbg.generated-->
        select [name], nm, credit_code, address, telephone, legal_person, capital, [scope], industry, etl_dt from
        pa_company_info
    </sql>

    <select id="selectPaCompanyInfoList" parameterType="com.kx.system.domain.PaCompanyInfo" resultMap="BaseResultMap">
        select distinct ci.[name], ci.nm, ci.credit_code, ci.address, ci.telephone, ci.legal_person, ci.capital,
        ci.[scope], ci.industry, ci.actual_controller, ci.etl_dt, ci.area_code,
        cai.outlet_code, cai.outlet, cai.manager_id, cai.township, cai.area, cai.type from pa_company_belong_info as cai
        left join pa_company_info as ci on ci.nm = cai.nm
        left join pa_client_label la on ci.nm = la.client_code
        <where>
            ci.nm is not null
            <if test="jobNumber != null and jobNumber != ''">
                and cai.manager_id = #{jobNumber}
            </if>
            <if test="clientName != null and clientName !=''">
                and ci.name like ('%'+ #{clientName}+'%')
            </if>
            <if test="areaCode != null and areaCode !=''">
                and ci.area_code = #{areaCode}
            </if>
            <if test="labelIdList != null">
                and la.label_id in
                <foreach item="labelId" collection="labelIdList" open="(" separator="," close=")">
                    #{labelId}
                </foreach>
            </if>
            <if test="villageNameList != null">
                and cai.area in
                <foreach item="villageName" collection="villageNameList" open="(" separator="," close=")">
                    #{villageName}
                </foreach>
            </if>
            <if test="areaCodeList != null">
                and cai.area_code in
                <foreach item="areaCode" collection="areaCodeList" open="(" separator="," close=")">
                    #{areaCode}
                </foreach>
            </if>
            <if test="networkCodes != null">
                and cai.outlet_code in
                <foreach item="networkCode" collection="networkCodes" open="(" separator="," close=")">
                    #{networkCode}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectPaCompanyInfoByNm" parameterType="String" resultMap="BaseResultMap">
        <include refid="selectPaCompanyInfoVo"/>
        where nm = #{nm}
    </select>

    <select id="selectPaCompanyInfoAndBelongToByNm" parameterType="String" resultMap="BaseResultMap">
        select [name], a.nm, credit_code, address, telephone, legal_person, capital, [scope], industry , b.outlet, b.outlet_code,b.manager_id,b.area,b.area_code
        from pa_company_info a left join pa_company_belong_info b on a.nm = b.nm
        where a.nm = #{nm}
    </select>

