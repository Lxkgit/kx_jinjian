<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.kx.system.mapper.PaTaskPositionMapper">


    <resultMap id="PaTaskPositionResultMap" type="com.kx.system.domain.PaTaskPosition" >
        <result column="manager_num" property="managerNum" />
        <result column="lon" property="lon" />
        <result column="lat" property="lat" />
        <result column="date" property="date" />
    </resultMap>


    <insert id="batchInsert">
        insert into pa_task_position
        (manager_num,lon,lat,date)
        values
        <foreach collection="paTaskPositions" item="i" separator=",">
            (#{i.managerNum},#{i.lon},#{i.lat},#{i.date})
        </foreach>
    </insert>
    <delete id="truncate">
        truncate table pa_task_position
    </delete>
    <delete id="deleteByDate">
        delete from pa_task_position
        where DATE_FORMAT(date,'%y-%m-%d') = DATE_FORMAT(#{date},'%Y-%m-%d')
    </delete>

    <select id="list" resultMap="PaTaskPositionResultMap">
        select manager_num,lon,lat,date
        from pa_task_position
        <where>
            <if test="managerNum != null and managerNum != ''">
                manager_num = #{managerNum}
            </if>
            <if test="date != null and date != ''">
                and DATE_FORMAT(date,'%Y-%m-%d') = #{date}
            </if>
        </where>
        order by date
    </select>
</mapper>
