<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.GridInfoCommunitySupervisorMapper">

    <resultMap id="BaseResultMap" type="com.kx.common.core.domain.system.grid.GridInfoCommunitySupervisor">
        <id property="id" column="id"/>
        <result property="gridCode" column="grid_code"/>
        <result property="supervisorName" column="supervisor_name"/>
        <result property="supervisorPhone" column="supervisor_phone"/>
        <result property="createTime" column="create_time"/>
        <result property="createName" column="create_name"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateName" column="update_name"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <!-- 新增 -->
    <insert id="insertGridInfoCommunitySupervisor" parameterType="com.kx.common.core.domain.system.grid.GridInfoCommunitySupervisor" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO grid_info_community_supervisor (
        <if test="gridCode != null and gridCode != ''">grid_code,</if>
        <if test="supervisorName != null and supervisorName != ''">supervisor_name,</if>
        <if test="supervisorPhone != null and supervisorPhone != ''">supervisor_phone,</if>
        <if test="createTime != null">create_time,</if>
        <if test="createName != null and createName != ''">create_name,</if>
        <if test="createBy != null">create_by,</if>
        <if test="updateTime != null">update_time,</if>
        <if test="updateName != null and updateName != ''">update_name,</if>
        <if test="updateBy != null">update_by</if>
        ) VALUES (
        <if test="gridCode != null and gridCode != ''">#{gridCode},</if>
        <if test="supervisorName != null and supervisorName != ''">#{supervisorName},</if>
        <if test="supervisorPhone != null and supervisorPhone != ''">#{supervisorPhone},</if>
        <if test="createTime != null">#{createTime},</if>
        <if test="createName != null and createName != ''">#{createName},</if>
        <if test="createBy != null">#{createBy},</if>
        <if test="updateTime != null">#{updateTime},</if>
        <if test="updateName != null and updateName != ''">#{updateName},</if>
        <if test="updateBy != null">#{updateBy}</if>
        )
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteGridInfoCommunitySupervisorById">
        DELETE FROM grid_info_community_supervisor WHERE id = #{id}
    </delete>

    <!-- 更新 -->
    <update id="updateGridInfoCommunitySupervisor" parameterType="com.kx.common.core.domain.system.grid.GridInfoCommunitySupervisor">
        UPDATE grid_info_community_supervisor
        <set>
            <if test="gridCode != null">grid_code = #{gridCode},</if>
            <if test="supervisorName != null">supervisor_name = #{supervisorName},</if>
            <if test="supervisorPhone != null">supervisor_phone = #{supervisorPhone},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateName != null">update_name = #{updateName},</if>
            <if test="updateBy != null">update_by = #{updateBy}</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据网格编码查询 -->
    <select id="selectGridInfoCommunitySupervisorList" parameterType="com.kx.common.core.domain.system.grid.GridInfoCommunitySupervisor" resultMap="BaseResultMap">
        SELECT * FROM grid_info_community_supervisor
        <where>
            <if test="gridCode != null and gridCode != ''">
                AND grid_code = #{gridCode}
            </if>
        </where>
    </select>



</mapper>