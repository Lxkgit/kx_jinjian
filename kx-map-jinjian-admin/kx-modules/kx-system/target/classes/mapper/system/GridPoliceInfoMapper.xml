<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.GridPoliceInfoMapper">

    <!-- 结果集映射 -->
    <resultMap id="BaseResultMap" type="com.kx.system.domain.grid.message.GridPoliceInfo">
        <id property="id" column="id"/>
        <result property="gridCode" column="grid_code"/>
        <result property="policeStationName" column="police_station_name"/>
        <result property="policeStationAddr" column="police_station_addr"/>
        <result property="policeName" column="police_name"/>
        <result property="policePhone" column="police_phone"/>
        <result property="createTime" column="create_time"/>
        <result property="createName" column="create_name"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateName" column="update_name"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <!-- 新增派出所信息 -->
    <insert id="insertGridPoliceInfo" parameterType="com.kx.system.domain.grid.message.GridPoliceInfo">
        INSERT INTO grid_police_info (grid_code, police_station_name, police_station_addr,
                                    police_name, police_phone, create_time,
                                    create_name, create_by, update_time,
                                    update_name, update_by)
        VALUES (#{gridCode}, #{policeStationName}, #{policeStationAddr},
                #{policeName}, #{policePhone}, #{createTime},
                #{createName}, #{createBy}, #{updateTime},
                #{updateName}, #{updateBy})
    </insert>

    <!-- 根据ID删除派出所信息 -->
    <delete id="deleteGridPoliceInfoById" parameterType="long">
        DELETE FROM grid_police_info WHERE id = #{id}
    </delete>

    <!-- 更新派出所信息 -->
    <update id="updateGridPoliceInfo" parameterType="com.kx.system.domain.grid.message.GridPoliceInfo">
        UPDATE grid_police_info
        <set>
            <if test="gridCode != null and gridCode != ''">
                grid_code = #{gridCode},
            </if>
            <if test="policeStationName != null and policeStationName != ''">
                police_station_name = #{policeStationName},
            </if>
            <if test="policeStationAddr != null and policeStationAddr != ''">
                police_station_addr = #{policeStationAddr},
            </if>
            <if test="policeName != null and policeName != ''">
                police_name = #{policeName},
            </if>
            <if test="policePhone != null and policePhone != ''">
                police_phone = #{policePhone},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
            <if test="updateName != null and updateName != ''">
                update_name = #{updateName},
            </if>
            <if test="updateBy != null">
                update_by = #{updateBy},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据网格编码查询派出所信息 -->
    <select id="selectGridPoliceInfoByGridCode" parameterType="string" resultMap="BaseResultMap">
        SELECT * FROM grid_police_info WHERE grid_code = #{gridCode}
    </select>

    <!-- 查询所有派出所信息 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM grid_police_info
    </select>

    <!-- 根据ID查询派出所信息 -->
    <select id="selectGridPoliceInfoById" parameterType="long" resultMap="BaseResultMap">
        SELECT * FROM grid_police_info WHERE id = #{id}
    </select>

