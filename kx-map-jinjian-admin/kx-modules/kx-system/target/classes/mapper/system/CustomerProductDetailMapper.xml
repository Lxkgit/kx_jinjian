<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.CustomerProductDetailMapper">

    <resultMap type="com.kx.system.domain.customer.CustomerProductDetail" id="CustomerProductDetailResult">
        <result property="id"    column="id"    />
        <result property="holderId"    column="holder_id"    />
        <result property="productType"    column="product_type"    />
        <result property="productId"    column="product_id"    />
        <result property="productCode"    column="product_code"    />
        <result property="productName"    column="product_name"    />
        <result property="handleAmount"    column="handle_amount"    />
        <result property="handleTime"    column="handle_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="manager"    column="manager"    />
        <result property="interestDate"    column="interest_date"    />
    </resultMap>

    <sql id="selectCustomerProductDetailVo">
        select id, holder_id, product_type, product_id, product_code, product_name, handle_amount, handle_time, end_time, manager, interest_date from customer_product_detail
    </sql>

    <select id="selectCustomerProductDetailList" parameterType="com.kx.system.domain.customer.CustomerProductDetail" resultMap="CustomerProductDetailResult">
        <include refid="selectCustomerProductDetailVo"/>
        <where>
            <if test="holderId != null "> and holder_id = #{holderId}</if>
            <if test="productType != null "> and product_type = #{productType}</if>
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="productCode != null  and productCode != ''"> and product_code = #{productCode}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="handleAmount != null "> and handle_amount = #{handleAmount}</if>
            <if test="handleTime != null "> and handle_time = #{handleTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="manager != null "> and manager = #{manager}</if>
            <if test="interestDate != null "> and interest_date = #{interestDate}</if>
        </where>
    </select>

    <select id="selectCustomerProductDetailById" parameterType="Long" resultMap="CustomerProductDetailResult">
        <include refid="selectCustomerProductDetailVo"/>
        where id = #{id}
    </select>

    <select id="selectListByHoldId" parameterType="Long" resultMap="CustomerProductDetailResult">
        <include refid="selectCustomerProductDetailVo"/>
        where holder_id = #{holdId}
    </select>

    <insert id="insertCustomerProductDetail" parameterType="com.kx.system.domain.customer.CustomerProductDetail" useGeneratedKeys="true" keyProperty="id">
        insert into customer_product_detail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="holderId != null">holder_id,</if>
            <if test="productType != null">product_type,</if>
            <if test="productId != null">product_id,</if>
            <if test="productCode != null">product_code,</if>
            <if test="productName != null">product_name,</if>
            <if test="handleAmount != null">handle_amount,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="manager != null">manager,</if>
            <if test="interestDate != null">interest_date,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="holderId != null">#{holderId},</if>
            <if test="productType != null">#{productType},</if>
            <if test="productId != null">#{productId},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="productName != null">#{productName},</if>
            <if test="handleAmount != null">#{handleAmount},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="manager != null">#{manager},</if>
            <if test="interestDate != null">#{interestDate},</if>
        </trim>
    </insert>

    <update id="updateCustomerProductDetail" parameterType="com.kx.system.domain.customer.CustomerProductDetail">
        update customer_product_detail
        <trim prefix="SET" suffixOverrides=",">
            <if test="holderId != null">holder_id = #{holderId},</if>
            <if test="productType != null">product_type = #{productType},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="handleAmount != null">handle_amount = #{handleAmount},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="manager != null">manager = #{manager},</if>
            <if test="interestDate != null">interest_date = #{interestDate},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCustomerProductDetailById" parameterType="Long">
        delete from customer_product_detail where id = #{id}
    </delete>

    <delete id="deleteCustomerProductDetailByIds" parameterType="String">
        delete from customer_product_detail where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>