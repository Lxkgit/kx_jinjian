<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.kx.system.mapper.SysBatchTaskRecordMapper">
    <insert id="insert">
        INSERT INTO sys_batch_task_record
        (task_name,status,auto_execute,params,ip,log,begin_time,end_time,execute_time)
        VALUES
        (#{taskName},#{status},#{autoExecute},#{params},#{ip},#{log},#{beginTime},#{endTime},#{executeTime})
    </insert>
</mapper>