            <if test="customGroup.customGroupSource != null">custom_group_source,</if>
            <if test="customGroup.groupDesc != null">group_desc,</if>
            <if test="customGroup.groupStatus != null">group_status,</if>
            <if test="customGroup.createBy != null">create_by,</if>
            <if test="customGroup.createTime != null">create_time,</if>
            <if test="customGroup.updateBy != null">update_by,</if>
            <if test="customGroup.updateTime != null">update_time,</if>
            <if test="customGroup.delFlag != null">del_flag,</if>
            <if test="customGroup.updateFlag != null">update_flag,</if>
            <if test="customGroup.labelIds != null">label_ids,</if>
            <if test="customGroup.createNum">create_num,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="customGroup.customType != null">#{customGroup.customType},</if>
            <if test="customGroup.categoryId != null">#{customGroup.categoryId},</if>
            <if test="customGroup.customGroupCode != null">#{customGroup.customGroupCode},</if>
            <if test="customGroup.customGroupName != null">#{customGroup.customGroupName},</if>
            <if test="customGroup.customMember != null">#{customGroup.customMember},</if>
            <if test="customGroup.customNum != null">#{customGroup.customNum},</if>
            <if test="customGroup.customGroupSource != null">#{customGroup.customGroupSource},</if>
            <if test="customGroup.groupDesc != null">#{customGroup.groupDesc},</if>
            <if test="customGroup.groupStatus != null">#{customGroup.groupStatus},</if>
            <if test="customGroup.createBy != null">#{customGroup.createBy},</if>
            <if test="customGroup.createTime != null">#{customGroup.createTime},</if>
            <if test="customGroup.updateBy != null">#{customGroup.updateBy},</if>
            <if test="customGroup.updateTime != null">#{customGroup.updateTime},</if>
            <if test="customGroup.delFlag != null">#{customGroup.delFlag},</if>
            <if test="customGroup.updateFlag != null">#{customGroup.updateFlag},</if>
            <if test="customGroup.labelIds != null">#{customGroup.labelIds},</if>
            <if test="customGroup.createNum != null">#{customGroup.createNum},</if>
        </trim>
    </insert>

    <update id="clearNum" parameterType="com.kx.system.domain.group.CustomGroup">
        update custom_group set custom_num = 0 where id = #{customGroup.id}
    </update>

