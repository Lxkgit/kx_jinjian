<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.GridRatingInfoMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="gridRatingInfoResultMap" type="com.kx.system.domain.grid.GridRatingInfo">
        <id column="id" property="id" />
        <result column="grid_message_id" property="gridMessageId" />
        <result column="grid_code" property="gridCode" />
        <result column="rating_year" property="ratingYear" />
        <result column="grid_rating" property="gridRating" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="police_name" property="policeName" />
        <result column="police_address" property="policeAddress" />
        <result column="un_faker_name" property="unFakerName" />
        <result column="un_faker_phone" property="unFakerPhone" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="columns">
        id, grid_message_id, grid_code, rating_year, grid_rating, create_time, update_time,police_name,police_address,un_faker_name,un_faker_phone
    </sql>
    <sql id="policeInfo">
        a.id, a.grid_message_id, a.grid_code, a.rating_year, a.grid_rating, a.create_time, a.update_time,a.police_name,a.police_address,a.un_faker_name,a.un_faker_phone,a.un_faker_mobile
    </sql>

    <!-- 查询列表 -->
    <select id="list" parameterType="com.kx.system.domain.grid.GridRatingInfo" resultMap="gridRatingInfoResultMap">
        select <include refid="policeInfo"/>
        from grid_rating_info a
        left join pa_addr_info_type b on b.parent_code=a.grid_code
        <where>
            <if test=" gridMessageId!=null and gridMessageId !='' "> and grid_message_id = #{gridMessageId } </if>
            <if test=" gridCode!=null and gridCode !='' "> and a.grid_code = #{gridCode } </if>
            <if test=" ratingYear!=null and ratingYear !='' "> and rating_year = #{ratingYear } </if>
            <if test=" gridRating!=null and gridRating !='' "> and grid_rating = #{gridRating } </if>
            <if test=" createTime!=null and createTime !='' "> and create_time = #{createTime } </if>
            <if test=" updateTime!=null and updateTime !='' "> and update_time = #{updateTime } </if>
        </where>
    </select>

    <!-- 根据id查询 -->
    <select id="getById"  resultMap="gridRatingInfoResultMap">
        select <include refid="columns"/>  from grid_rating_info where id = #{id}
    </select>

    <select id="getByYear"  resultMap="gridRatingInfoResultMap">
        select <include refid="columns"/>  from grid_rating_info where rating_year = #{ratingYear} and grid_code = #{gridCode}
    </select>

    <!-- 根据id删除 -->
    <delete id="deleteById">
        delete from  grid_rating_info where  id= #{id}
    </delete>

    <!-- 新增 -->
    <insert id="insertGridRatingInfo" parameterType="com.kx.system.domain.grid.GridRatingInfo" keyProperty="id" useGeneratedKeys="true">
        insert into grid_rating_info(
            grid_message_id,grid_code,rating_year,grid_rating,create_time,update_time,police_name,police_address,un_faker_name,un_faker_phone
        )values(
                   #{gridMessageId}, #{gridCode}, #{ratingYear}, #{gridRating}, #{createTime}, #{updateTime},#{policeName},#{policeAddress},#{unFakerName},#{unFakerPhone}
               )
    </insert>

    <!-- 更新 -->
    <update id="updateGridRatingInfo" parameterType="com.kx.system.domain.grid.GridRatingInfo">
        update grid_rating_info
        <trim prefix="SET" suffixOverrides=",">
            <if test=" gridMessageId!=null and gridMessageId !='' ">  grid_message_id = #{gridMessageId } ,</if>
            <if test=" gridCode!=null and gridCode !='' ">  grid_code = #{gridCode } ,</if>
            <if test=" ratingYear!=null and ratingYear !='' ">  rating_year = #{ratingYear } ,</if>
            <if test=" gridRating!=null and gridRating !='' ">  grid_rating = #{gridRating } ,</if>
            <if test=" createTime!=null">  create_time = #{createTime } ,</if>
            <if test=" updateTime!=null">  update_time = #{updateTime } ,</if>
            <if test=" policeName!=null and policeName !='' ">  police_name = #{policeName} ,</if>
            <if test=" policeAddress!=null and policeAddress !='' ">  police_address = #{policeAddress} ,</if>
            <if test=" unFakerName!=null and unFakerName !='' ">  un_faker_name = #{unFakerName} ,</if>
            <if test=" unFakerPhone!=null and unFakerPhone !='' ">  un_faker_phone = #{unFakerPhone} </if>
        </trim>
        where id = #{id}
    </update>

</mapper>
