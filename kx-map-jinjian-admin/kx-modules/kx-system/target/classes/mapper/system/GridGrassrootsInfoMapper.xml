<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kx.system.mapper.GridGrassrootsInfoMapper">

    <!-- 通用resultMap -->
    <resultMap id="BaseResultMap" type="com.kx.system.domain.grid.message.GridGrassrootsInfo">
        <id column="id" property="id"/>
        <result column="grid_code" property="gridCode"/>
        <result column="organization_name" property="organizationName"/>
        <result column="organization_type" property="organizationType"/>
        <result column="contacts_name" property="contactsName"/>
        <result column="contacts_phone" property="contactsPhone"/>
        <result column="create_time" property="createTime"/>
        <result column="create_name" property="createName"/>
        <result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="update_name" property="updateName"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <!-- 新增记录 -->
    <insert id="insertGridGrassrootsInfo" parameterType="com.kx.system.domain.grid.message.GridGrassrootsInfo">
        INSERT INTO grid_grassroots_info (grid_code, organization_name, organization_type,
                                          contacts_name, contacts_phone, create_time,
                                          create_name, create_by, update_time,
                                          update_name, update_by)
        VALUES (#{gridCode}, #{organizationName}, #{organizationType},
                #{contactsName}, #{contactsPhone}, #{createTime},
                #{createName}, #{createBy}, #{updateTime},
                #{updateName}, #{updateBy})
    </insert>

    <!-- 根据ID删除 -->
    <delete id="deleteGridGrassrootsInfoById" parameterType="long">
        DELETE
        FROM grid_grassroots_info
        WHERE id = #{id}
    </delete>

    <!-- 更新记录 -->
    <update id="updateGridGrassrootsInfo" parameterType="com.kx.system.domain.grid.message.GridGrassrootsInfo">
        UPDATE grid_grassroots_info
        <set>
            <if test="gridCode != null">grid_code = #{gridCode},</if>
            <if test="organizationName != null">organization_name = #{organizationName},</if>
            <if test="organizationType != null">organization_type = #{organizationType},</if>
            <if test="contactsName != null">contacts_name = #{contactsName},</if>
            <if test="contactsPhone != null">contacts_phone = #{contactsPhone},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateName != null">update_name = #{updateName},</if>
            <if test="updateBy != null">update_by = #{updateBy}</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据网格编码查询 -->
    <select id="selectGridGrassrootsInfoByGridCode" parameterType="string" resultMap="BaseResultMap">
        SELECT *
        FROM grid_grassroots_info
        WHERE grid_code = #{gridCode}
    </select>

        <resultMap id="BaseResultMap2" type="com.kx.system.domain.GridGrassrootsInfo2">
            <id column="id" property="id" />
            <result column="contact_name" property="contactName" />
            <result column="contact_phone" property="contactPhone" />
            <result column="grid_code" property="gridCode" />
            <result column="create_time" property="createTime" />
            <result column="update_time" property="updateTime" />
            <result column="grassroots" property="grassroots" />
            <result column="grassroots_type" property="grassrootsType" />
        </resultMap>

        <sql id="SelectGrassroots">
            id, grassroots, grassroots_type, contact_name, contact_phone, grid_code, create_time, update_time
        </sql>
        <select id="findById" resultMap="BaseResultMap2">
            SELECT
            <include refid="SelectGrassroots"/>
            FROM grid_grassroots_info WHERE id = #{id}
        </select>

        <select id="findByGridCode" resultMap="BaseResultMap2">
            SELECT <include refid="SelectGrassroots"/> FROM grid_grassroots_info WHERE grid_code = #{gridCode}
        </select>

        <select id="findAll" resultMap="BaseResultMap2">
            SELECT <include refid="SelectGrassroots"/> FROM grid_grassroots_info
        </select>

        <insert id="insert">
            INSERT INTO grid_grassroots_info (contact_name, contact_phone, grid_code, create_time, update_time,grassroots,grassroots_type)
            VALUES (#{contactName}, #{contactPhone}, #{gridCode}, #{createTime}, #{updateTime},#{grassroots},#{grassrootsType})
        </insert>

        <update id="update">
            UPDATE grid_grassroots_info
            SET contact_name = #{contactName}, contact_phone = #{contactPhone}, grid_code = #{gridCode}, update_time = #{updateTime},grassroots=#{grassroots},grassroots_type=#{grassrootsType}
            WHERE id = #{id}
        </update>

        <delete id="deleteById">
            DELETE FROM grid_grassroots_info WHERE id = #{id}
        </delete>
</mapper>